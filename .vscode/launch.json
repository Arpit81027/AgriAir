{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AgriAir: Run website",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000",
                "--noreload"
            ],
            "django": true,
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Starting development server at (https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}
